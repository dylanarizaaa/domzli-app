# Copia este archivo como .env y completa los valores de tu proyecto de Supabase.
# Todo lo que empieza por EXPO_PUBLIC_ queda incluido en la app: nunca pongas aquí claves secretas.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica
# Opcional: habilita /catalog (muestrario de componentes) fuera del modo desarrollo.
EXPO_PUBLIC_ENABLE_CATALOG=0
