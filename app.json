{
  "expo": {
    "name": "Domzli",
    "slug": "domzli",
    "scheme": "domzli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domzli.app"
    },
    "android": {
      "package": "com.domzli.app",
      "adaptiveIcon": {
        "backgroundColor": "#4859DD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#4859DD" }],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
